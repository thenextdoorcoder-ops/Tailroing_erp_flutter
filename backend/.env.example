# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public&pgbouncer=true&connection_limit=1"

JWT_SECRET="generate-a-random-64-char-secret"
JWT_EXPIRES_IN="7d"

PORT=5000
NODE_ENV="production"

FRONTEND_URL="https://your-frontend-url.vercel.app"

MAX_FILE_SIZE=5242880

TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_NUMBER=+91xxxxxxxxxx

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="client@gmail.com"
EMAIL_PASS="gmail-app-password"
APP_NAME="Client Shop Name"

GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="https://your-api-url.onrender.com/api/auth/google/callback"

CORS_ORIGINS="https://your-frontend-url.vercel.app"

# Supabase (Cloud Image Storage)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="designs"iloring"

# E-Commerce Payment (Manual UPI)
