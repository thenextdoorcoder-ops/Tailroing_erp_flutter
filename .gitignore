# ==========================================
# Tailoring ERP - Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets
# ------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.p12
*.pfx

# ------------------------------------------
# Node / Backend / Frontend Dependencies & Build
# ------------------------------------------
node_modules/
*/node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
**/dist/
build/
**/build/
.next/
.nuxt/
.out/
.cache/
.parcel-cache/
.turbo/
.vite/

# ------------------------------------------
# Flutter / Dart / Mobile
# ------------------------------------------
.dart_tool/
**/.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/doc/api/

# Android Specific
**/android/.gradle/
**/android/captures/
**/android/gradleBuild/
**/android/local.properties
**/android/key.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.keystore
*.jks

# iOS / macOS Specific
**/ios/.symlinks/
**/ios/Pods/
**/ios/Podfile.lock
**/ios/Flutter/.last_build_id
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/ephemeral/
**/ios/DerivedData/
*.ipa
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3

# Binaries & Packages
*.apk
*.aab
*.app
*.dylib
*.dll
*.so
*.exe
*.dex

# Extracted APK files & reverse engineering artifacts
extracted_apk/
**/extracted_apk/

# ------------------------------------------
# Testing & Code Coverage
# ------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/

# ------------------------------------------
# IDEs and Editors
# ------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# ------------------------------------------
# Operating System Files
# ------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~

# ------------------------------------------
# Logs
# ------------------------------------------
*.log
logs/

# ------------------------------------------
# AI Assistants / Tooling metadata
# ------------------------------------------
.claude/

